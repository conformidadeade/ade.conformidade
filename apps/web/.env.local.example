# Adendo "Deploy em produção" (09/09/2026, revisado) — URL absoluta da API.
# É NEXT_PUBLIC_* de propósito: o navegador chama a API diretamente (sem
# proxy — ver next.config.ts para o motivo). Em produção, aponta para o
# subdomínio da API (ex.: https://api.<seu-domínio>), nunca a URL do
# Railway hardcoded aqui.
NEXT_PUBLIC_API_URL="http://localhost:4001"
