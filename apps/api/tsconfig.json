{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "outDir": "./dist",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUncheckedIndexedAccess": false,
    "strictPropertyInitialization": false,
    "target": "ES2022",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
