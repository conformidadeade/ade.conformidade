DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reanalise_erp?schema=public"
JWT_ACCESS_SECRET="troque-este-valor-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-este-valor-tambem"
JWT_REFRESH_TTL="7d"
PORT="4001"

# Sessão via cookie httpOnly + CSRF (adendo "Segurança de sessão", 08/09/2026;
# arquitetura revisada em 09/09/2026 — ver auth-cookies.ts para o motivo: a
# Vercel não consegue fazer proxy same-origin pro range de IP do Railway).
# CORS_ORIGIN: domínio do frontend — agora estritamente necessário (o
# navegador chama a API diretamente, cross-origin de verdade). Nunca "*".
CORS_ORIGIN="http://localhost:4002"
# COOKIE_SECURE: "true" exige HTTPS (obrigatório em produção — o sistema terá exposição externa).
# Em dev local (http://localhost, sem HTTPS) precisa ser "false", senão o navegador descarta os cookies.
COOKIE_SECURE="false"
# COOKIE_DOMAIN: em produção, o domínio RAIZ com um ponto na frente (ex.:
# ".adeonline.com.br") — isso deixa o cookie válido tanto para
# www.adeonline.com.br (frontend) quanto api.adeonline.com.br (backend), os
# dois subdomínios reais. Em dev local, deixe vazio (cookie host-only).
COOKIE_DOMAIN=

# E-mail transacional (adendo "Confirmação de e-mail e recuperação de
# senha", 09/09/2026) — convite de conta nova e "esqueci minha senha".
# Provedor: Resend (free tier, 3000 e-mails/mês), enviando do domínio
# próprio adeonline.com.br (não do e-mail corporativo conformidade@calia.com.br
# — evita depender de acesso ao Microsoft 365 da empresa; o domínio novo já
# está sob nosso Cloudflare). Ver docs/DEPLOY.md para os registros DNS de
# verificação de domínio no Resend.
# RESEND_API_KEY: chave de API do Resend (Dashboard → API Keys). Sem ela
# (dev local), o EmailService só LOGA o e-mail que enviaria, sem chamar a
# rede de verdade — não precisa de conta no Resend para rodar localmente.
RESEND_API_KEY=
# EMAIL_FROM: remetente dos e-mails transacionais. Precisa ser um endereço
# do domínio verificado no Resend (ex.: sistema@adeonline.com.br ou
# naoresponda@adeonline.com.br) — não é uma caixa de e-mail real, ninguém
# precisa ler respostas enviadas para ele.
EMAIL_FROM="naoresponda@adeonline.com.br"
