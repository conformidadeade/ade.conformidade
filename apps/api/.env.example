DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reanalise_erp?schema=public"
JWT_ACCESS_SECRET="troque-este-valor-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-este-valor-tambem"
JWT_REFRESH_TTL="7d"
PORT="4001"

# Sessão via cookie httpOnly + CSRF (adendo "Segurança de sessão", 08/09/2026).
# CORS_ORIGIN: domínio do frontend — usado como camada extra de defesa (o fluxo
# principal do navegador passa pelo proxy same-origin da Vercel, ver adendo
# "Deploy em produção", então CORS deixa de ser estritamente necessário para
# ele, mas mantenha configurado mesmo assim). Nunca "*" — precisa ser explícito
# para cookies funcionarem entre origens nos casos em que CORS ainda se aplica.
CORS_ORIGIN="http://localhost:4002"
# COOKIE_SECURE: "true" exige HTTPS (obrigatório em produção — o sistema terá exposição externa).
# Em dev local (http://localhost, sem HTTPS) precisa ser "false", senão o navegador descarta os cookies.
COOKIE_SECURE="false"
# COOKIE_DOMAIN: deixe SEMPRE vazio — inclusive em produção (Vercel + Railway
# atrás do proxy same-origin, ver adendo "Deploy em produção"). O navegador só
# fala com o domínio do FRONTEND; um Domain apontando para o Railway quebraria
# o cookie. Só preencher num cenário futuro sem proxy (não é o caso hoje).
COOKIE_DOMAIN=
